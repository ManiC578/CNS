#include <stdio.h>
#include <string.h>

int main()
{
    char text[100], encrypted[100], decrypted[100];
    int i, j = 0, len;

    printf("Enter plain text: ");
    scanf("%s", text);
    len = strlen(text);

    // Encryption
    for (i = 0; i < len; i += 2)
    {
        encrypted[j] = text[i];
        j++;
    }
    for (i = 1; i < len; i += 2)
    {
        encrypted[j] = text[i];
        j++;
    }
    encrypted[j] = '\0';
    printf("Encrypted text: %s\n", encrypted);

    // Decryption
    j = 0;
    for (i = 0; i < len; i += 2)
    {
        decrypted[i] = encrypted[j];
        j++;
    }
    for (i = 1; i < len; i += 2)
    {
        decrypted[i] = encrypted[j];
        j++;
    }
    decrypted[len] = '\0';
    printf("Decrypted text: %s\n", decrypted);

    return 0;
}
