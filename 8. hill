#include <stdio.h>
#include <string.h>

int main()
{
    int key[3][3] = {
        {6, 24, 1},
        {13, 16, 10},
        {20, 17, 15}
    };

    int inv[3][3] = {
        {8, 5, 10},
        {21, 8, 21},
        {21, 12, 8}
    };

    char text[100], enc[100], dec[100];
    int i, a, b, c;

    printf("Enter plaintext: ");
    scanf("%s", text);

    /* Encryption */
    for(i = 0; text[i] != '\0'; i += 3)
    {
        a = text[i] - 'A';
        b = text[i + 1] - 'A';
        c = text[i + 2] - 'A';

        enc[i]     = ((a * key[0][0] + b * key[1][0] + c * key[2][0]) % 26) + 'A';
        enc[i + 1] = ((a * key[0][1] + b * key[1][1] + c * key[2][1]) % 26) + 'A';
        enc[i + 2] = ((a * key[0][2] + b * key[1][2] + c * key[2][2]) % 26) + 'A';
    }
    enc[i] = '\0';
    printf("Encrypted text: %s\n", enc);

    /* Decryption */
    for(i = 0; enc[i] != '\0'; i += 3)
    {
        a = enc[i] - 'A';
        b = enc[i + 1] - 'A';
        c = enc[i + 2] - 'A';

        dec[i]     = ((a * inv[0][0] + b * inv[1][0] + c * inv[2][0]) % 26) + 'A';
        dec[i + 1] = ((a * inv[0][1] + b * inv[1][1] + c * inv[2][1]) % 26) + 'A';
        dec[i + 2] = ((a * inv[0][2] + b * inv[1][2] + c * inv[2][2]) % 26) + 'A';
    }
    dec[i] = '\0';
    printf("Decrypted text: %s\n", dec);

    return 0;
}
